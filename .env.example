# Browser-safe Supabase values only. Never put service-role or provider secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Configure these in Supabase Edge Function secrets for production.
# Comma-separated exact origins; do not use wildcard origins.
APP_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.example
# Edge Function runtime supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# WhatsApp secrets (configure only if using the Cloud API):
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# WHATSAPP_PAYMENT_TEMPLATE=payment_confirmation
# WHATSAPP_WINNER_TEMPLATE=draw_winner_announcement
